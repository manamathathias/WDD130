    __typename
    key
    name
    url
    iconData
  }
`,j=`
  fragment RLPAtlasGoalFragment on TownsquareGoal {
    __typename
    key
    name
    url
    iconData
  }
`,w=`
  fragment RLPJiraSingleIssueLineTextFieldFragment on JiraSingleLineTextField {
    text
  }
`,I=`
  fragment RLPJiraIssueFragment on JiraIssue {
    __typename
    key
    webUrl
    statusCategory {
      name,
      colorName
    }
    issueType {
      avatar {
        small
      }
    }
    fieldsById(ids: ["summary"]) {
      edges {
        node {
          __typename
          ...RLPJiraSingleIssueLineTextFieldFragment
        }
      }
    }
  }
  `.concat(w,`
`),P=`
  fragment RLPGraphDocumentFragment on ExternalDocument {
    id
    type {
        category
    }
    displayName
    parent @optIn(to: "ExternalDataDepotQueryV2"){
        ... on ExternalDocument {
            displayName
        }
    }
    url
    provider {
        providerId
    }
  }
`,O=`
  fragment RLPGraphRemoteLinkFragment on ExternalRemoteLink {
    id
    displayName
    category @optIn(to: "ExternalDataDepotQueryV2")
    url
    provider {
      providerId
    }
  }
`,T=`
  fragment RLPLoomVideoFragment on LoomVideo {
    name
    loomUrl: url
  }
`,S=`
  fragment RLPAssetsObjectFragment on AssetsObject {
    id
    displayTypename @optIn(to: "AssetsApFields")
    links {
      web
    }
    assetsLabel: label
    objectKey
    assetsIcon: avatar {
      url48
    }
    objectType {
      schema {
        name
      }
    }
  }
`,k=`
  fragment RLPAssetsObjectTypeFragment on AssetsObjectType {
    id
    displayTypename @optIn(to: "AssetsApFields")
    links {
      web
    }
    assetsLabel: name
    assetsIcon: icon {
      url48
    }
    schema {
      assetsSchemaName: name
    }
  }
`,D=`
  fragment RLPAssetsSchemaFragment on AssetsSchema {
    id
    displayTypename @optIn(to: "AssetsApFields")
    links {
      web
    }
    assetsLabel: name
  }
