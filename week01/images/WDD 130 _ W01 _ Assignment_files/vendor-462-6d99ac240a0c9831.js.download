	fragment YWJiraSingleLineTextField on JiraSingleLineTextField {
		text
		issue {
			projectField {
				project {
					name
				}
			}
			issueTypeField {
				issueType {
					name
					hierarchy {
						level
					}
				}
			}
		}
	}

	fragment YWJiraIssue on JiraIssue {
		__typename
		key
		webUrl
		issueType {
			avatar {
				small
			}
		}
		fieldsById(ids: ["summary"]) {
			edges {
				node {
					__typename
					...YWJiraSingleLineTextField
				}
			}
		}
	}
`,G=`
	fragment YWAtlasProject on TownsquareProject {
		__typename
		key
		name
		url
		iconData
	}

	fragment YWAtlasGoal on TownsquareGoal {
		__typename
		key
		name
		url
		iconData
	}
`,N=`
	query `.concat(D,`(
		$filteredProducts: [String!]
		$filteredObjectTypes: [String!]
		$filteredEventTypes: [String!]
		$itemsLimit: Int!
		$filteredRootContainerIds: [ID!]
		$after: String
	) {
		activity {
			myActivity {
				all(
					filter: {
						arguments: {
							products: $filteredProducts
							objectTypes: $filteredObjectTypes
							eventTypes: $filteredEventTypes
						}
						rootContainerIds: $filteredRootContainerIds
					}
					first: $itemsLimit
					after: $after
				) {
					__typename
					edges {
						cursor
						__typename
						node {
							__typename
							object {
								__typename
								id
								type
								product
								data {
									__typename
									...YWJiraIssue
									...YWAtlasProject
									...YWAtlasGoal
								}
							}
							event {
								__typename
								eventType
								timestamp
							}
						}
					}
				}
			}
		}
	}
	`).concat($,`
	`).concat(G,`
