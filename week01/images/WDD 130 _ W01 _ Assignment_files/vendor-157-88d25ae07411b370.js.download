	/* CSS reset */
	font-family: `,`;
	font-size: 14px;
	flex-grow: 1;

	/* These styles and animations are derived from @atlaskit/tooltip */

	.`,` {
		background-color: `,`;
		color: `,`;
		border-radius: `,`;
		box-sizing: border-box;
		font: `,`;
		line-height: 1.3;
		max-width: 240px;
		padding: `," ",`;
		word-wrap: break-word;
		overflow-wrap: break-word;
		z-index: `,`;
		pointer-events: none;
		position: absolute;
		visibility: hidden;

		/* Horizontally center and vertically position above the target element */
		transform: translate(-50%, calc(-100% - `,`));

		&.`,` {
			animation: `,` 350ms cubic-bezier(0.15, 1, 0.3, 1);
			visibility: visible;
		}

		&.`,` {
			animation: `,` 350ms cubic-bezier(0.15, 1, 0.3, 1);
