 of how many custom instructions match the current search query."},customInstructionsDeletedAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsDeletedAnnouncement",defaultMessage:"Instruction deleted.",description:"Screen-reader announcement made after a custom instruction is deleted."},customInstructionsRemovedAllAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsRemovedAllAnnouncement",defaultMessage:"All instructions removed.",description:"Screen-reader announcement made after all custom instructions are removed."},customInstructionsAddedAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsAddedAnnouncement",defaultMessage:"Instruction added.",description:"Screen-reader announcement made after a custom instruction is added."},loadingLabel:{id:"rovo-personalization.response-style-tab.loadingLabel",defaultMessage:"Loading response style settings",description:"Accessible label shown while the response style settings are loading."},savingStatus:{id:"rovo-personalization.response-style-tab.savingStatus",defaultMessage:"Saving your response style…",description:"Status announced to screen readers while a response style change is being saved."},savedStatus:{id:"rovo-personalization.response-style-tab.savedStatus",defaultMessage:"Response style saved",description:"Status announced to screen readers after a response style change is saved successfully."},saveErrorStatus:{id:"rovo-personalization.response-style-tab.saveErrorStatus",defaultMessage:"Couldn't save your response style change. Please try again.",description:"Status announced to screen readers when saving a response style change fails and the change is reverted."},lengthLabel:{id:"rovo-personalization.response-style-tab.lengthLabel",defaultMessage:"Length",description:"Label for the Length dropdown that controls how long Rovo responses should be."},lengthShorter:{id:"rovo-personalization.response-style-tab.lengthShorter",defaultMessage:"Shorter",description:"Option label for the shorter length choice in the Length dropdown."},lengthLonger:{id:"rovo-personalization.response-style-tab.lengthLonger",defaultMessage:"Longer",description:"Option label for the longer length choice in the Length dropdown."},structureLabel:{id:"rovo-personalization.response-style-tab.structureLabel",defaultMessage:"Structure",description:"Label for the Structure dropdown that controls how structured Rovo responses should be."},structureMore:{id:"rovo-personalization.response-style-tab.structureMore",defaultMessage:"More structured",description:"Option label for the more structured choice in the Structure dropdown."},structureLess:{id:"rovo-personalization.response-style-tab.structureLess",defaultMessage:"Less structured",description:"Option label for the less structured choice in the Structure dropdown."},emojisLabel:{id:"rovo-personalization.response-style-tab.emojisLabel",defaultMessage:"Emojis",description:"Label for the Emojis dropdown that controls how often emojis appear in Rovo responses."},emojisNone:{id:"rovo-personalization.response-style-tab.emojisNone",defaultMessage:"No emojis",description:"Option label for the no-emojis choice in the Emojis dropdown."},emojisMore:{id:"rovo-personalization.response-style-tab.emojisMore",defaultMessage:"More emojis",description:"Option label for the more-emojis choice in the Emojis dropdown."}}),x=function(e){var t=e.headingId,n=e.initialInstructions,o=(0,a.A)().formatMessage,i=(0,r.useState)(function(){return(0,y.A)(null!=n?n:[])}),s=(0,w.A)(i,2),p=s[0],u=s[1],h=(0,r.useState)({id:0,message:""}),f=(0,w.A)(h,2),m=f[0],b=f[1],x=(0,r.useState)(!1),I=(0,w.A)(x,2),D=I[0],A=I[1],C=(0,r.useState)(""),L=(0,w.A)(C,2),P=L[0],T=L[1],R=(0,r.useState)(null),j=(0,w.A)(R,2),O=j[0],W=j[1],q=(0,r.useRef)(null),N=(0,r.useRef)(null);(0,r.useEffect)(function(){if(O){if("add"===O.kind){D||(null==(n=N.current)||n.focus(),W(null));return}var e,t,n,o=Array.from(null!=(e=null==(t=q.current)?void 0:t.querySe