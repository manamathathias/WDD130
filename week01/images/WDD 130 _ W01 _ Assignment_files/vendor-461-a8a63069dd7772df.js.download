o response tone option card."},toneProfessional:{id:"rovo-personalization.response-style-tab.toneProfessional",defaultMessage:"Professional",description:"Option label for a professional Rovo response tone."},toneProfessionalDescription:{id:"rovo-personalization.response-style-tab.toneProfessionalDescription",defaultMessage:"Straightforward and polished",description:"Description for the professional Rovo response tone option card."},toneCreative:{id:"rovo-personalization.response-style-tab.toneCreative",defaultMessage:"Creative",description:"Option label for a creative Rovo response tone."},toneCreativeDescription:{id:"rovo-personalization.response-style-tab.toneCreativeDescription",defaultMessage:"Focused on exploring fresh ideas",description:"Description for the creative Rovo response tone option card."},toneEmpathetic:{id:"rovo-personalization.response-style-tab.toneEmpathetic",defaultMessage:"Empathetic",description:"Option label for an empathetic Rovo response tone."},toneEmpatheticDescription:{id:"rovo-personalization.response-style-tab.toneEmpatheticDescription",defaultMessage:"Supportive, thoughtful, and practical",description:"Description for the empathetic Rovo response tone option card."},characteristicsSectionTitle:{id:"rovo-personalization.response-style-tab.characteristicsSectionTitle",defaultMessage:"Response characteristics",description:"Title of the section for choosing response characteristics such as length and structure."},neutral:{id:"rovo-personalization.response-style-tab.neutral",defaultMessage:"Neutral",description:"Option label for a response characteristic with no directional preference."},tldrLabel:{id:"rovo-personalization.response-style-tab.tldrLabel",defaultMessage:"TLDR",description:'Label for the preference control that toggles a TLDR in Rovo responses. "TLDR" stands for "too long; didn\'t read" and is a brief summary placed at the top of a longer response.'},tldrEnabled:{id:"rovo-personalization.response-style-tab.tldrEnabled",defaultMessage:"Include TLDR",description:'Option label for enabling the TLDR in Rovo responses. "TLDR" stands for "too long; didn\'t read" and is a brief summary placed at the top of a longer response.'},tldrDisabled:{id:"rovo-personalization.response-style-tab.tldrDisabled",defaultMessage:"No TLDR",description:'Option label for disabling the TLDR in Rovo responses. "TLDR" stands for "too long; didn\'t read" and is a brief summary placed at the top of a longer response.'},customInstructionsSectionTitle:{id:"rovo-personalization.response-style-tab.customInstructionsSectionTitle",defaultMessage:"All custom instructions",description:"Title of the section previewing the user’s saved custom instructions."},customInstructionsRemoveAll:{id:"rovo-personalization.response-style-tab.customInstructionsRemoveAll",defaultMessage:"Remove all",description:"Label for the button that removes all custom instructions."},customInstructionsAdd:{id:"rovo-personalization.response-style-tab.customInstructionsAdd",defaultMessage:"Add instruction",description:"Label for the button that opens the inline custom instruction form."},customInstructionsAddError:{id:"rovo-personalization.response-style-tab.customInstructionsAddError",defaultMessage:"Rovo couldn't add this custom instruction. Try again.",description:"Error shown when inline custom instruction creation fails."},customInstructionsCancel:{id:"rovo-personalization.response-style-tab.customInstructionsCancel",defaultMessage:"Cancel",description:"Label for the button that closes the new custom-instruction input without adding one."},customInstructionsInputLabel:{id:"rovo-personalization.response-style-tab.customInstructionsInputLabel",defaultMessage:"New custom instruction",description:"Accessible label for the new custom-instruction text input."},customInstructionsInputPlaceholder:{id:"rovo-personalization.response-style-tab.customInstructionsInputPlaceholder",defaultMessage:"Add a custom instruction",description:"Placeholder text for the new custom-instruction text input."},customInstructionsSubmitLabel:{id:"rovo-personalization.response-style-tab.customInstructionsSubmitLabel",defaultMessage:"Add instruction",description:"Accessible label for the button that submits a new custom instruction."},customInstructionsSeeAll:{id:"rovo-personalization.response-style-tab.customInstructionsSeeAll",defaultMessage:"See all instructions",description:"Label for the button that opens explicit memory management."},customInstructionsLoading:{id:"rovo-personalization.response-style-tab.customInstructionsLoading",defaultMessage:"Loading custom instructions…",description:"Status announced while custom instructions are loading."},customInstructionsError:{id:"rovo-personalization.response-style-tab.customInstructionsError",defaultMessage:"Rovo couldn't load your custom instructions.",description:"Error announced when custom instructions fail to load."},customInstructionsRetry:{id:"rovo-personalization.response-style-tab.customInstructionsRetry",defaultMessage:"Retry loading",description:"Button label for retrying custom instruction loading."},customInstructionsDelete:{id:"rovo-personalization.response-style-tab.customInstructionsDelete",defaultMessage:"Delete custom instruction",description:"Accessible label for deleting a custom instruction from the preview."},customInstructionsDeleteConfirmHeading:{id:"rovo-personalization.response-style-tab.customInstructionsDeleteConfirmHeading",defaultMessage:"Delete this instruction?",description:"Heading shown when confirming deletion of a custom instruction."},customInstructionsDeleteConfirmDescription:{id:"rovo-personalization.response-style-tab.customInstructionsDeleteConfirmDescription",defaultMessage:"This instruction will be permanently deleted.",description:"Description shown when confirming deletion of a custom instruction."},customInstructionsDeleteCancel:{id:"rovo-personalization.response-style-tab.customInstructionsDeleteCancel",defaultMessage:"Cancel",description:"Button label for cancelling custom instruction deletion."},customInstructionsDeleteConfirm:{id:"rovo-personalization.response-style-tab.customInstructionsDeleteConfirm",defaultMessage:"Delete",description:"Button label for confirming custom instruction deletion."},customInstructionsDeleteError:{id:"rovo-personalization.response-style-tab.customInstructionsDeleteError",defaultMessage:"Rovo couldn't delete this custom instruction. Try again.",description:"Error shown when deleting a custom instruction fails."},customInstructionsSearchLabel:{id:"rovo-personalization.response-style-tab.customInstructionsSearchLabel",defaultMessage:"Search custom instructions",description:"Accessible label for the field that filters the custom instructions list."},customInstructionsSearchPlaceholder:{id:"rovo-personalization.response-style-tab.customInstructionsSearchPlaceholder",defaultMessage:"Search instructions",description:"Placeholder text for the field that filters the custom instructions list."},customInstructionsToggleLabel:{id:"rovo-personalization.response-style-tab.customInstructionsToggleLabel",defaultMessage:"Instruction: {instruction}",description:"Accessible label for the toggle that enables or disables a single custom instruction. State-neutral so it reads correctly whether the toggle is on or off (the toggle role announces the on/off state)."},customInstructionsDeleteLabel:{id:"rovo-personalization.response-style-tab.customInstructionsDeleteLabel",defaultMessage:"Delete instruction",description:"Accessible label and tooltip for the button that deletes a custom instruction."},customInstructionsNewPlaceholder:{id:"rovo-personalization.response-style-tab.customInstructionsNewPlaceholder",defaultMessage:"New custom instruction",description:"Placeholder text for a newly added, not-yet-edited custom instruction."},customInstructionsNoResults:{id:"rovo-personalization.response-style-tab.customInstructionsNoResults",defaultMessage:"No instructions match your search.",description:"Empty-state text shown when a search returns no matching custom instructions."},customInstructionsResultsAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsResultsAnnouncement",defaultMessage:"{count, plural, one {# instruction} other {# instructions}} match your search.",description:"Screen-reader announcement of how many custom instructions match the current search query."},customInstructionsDeletedAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsDeletedAnnouncement",defaultMessage:"Instruction deleted.",description:"Screen-reader announcement made after a custom instruction is deleted."},customInstructionsRemovedAllAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsRemovedAllAnnouncement",defaultMessage:"All instructions removed.",description:"Screen-reader announcement made after all custom instructions are removed."},customInstructionsAddedAnnouncement:{id:"rovo-personalization.response-style-tab.customInstructionsAddedAnnouncement",defaultMessage:"Instruction added.",description:"Screen-reader announcement made after a custom instruction is added."},loadingLabel:{id:"rovo-personalization.response-style-tab.loadingLabel",defaultMessage:"Loading response style settings",description:"Accessible label shown while the response style settings are loading."},readErrorFlagTitle:{id:"rovo-personalization.response-style-tab.readErrorFlagTitle",defaultMessage:"Response style settings could not be loaded.",description:"Visible error notification after response style settings fail to load."},readErrorRetry:{id:"rovo-personalization.response-style-tab.readErrorRetry",defaultMessage:"Retry",description:"Button label for retrying response style settings loading."},savingStatus:{id:"rovo-personalization.response-style-tab.savingStatus",defaultMessage:"Saving your response style…",description:"Status announced to screen readers while a response style change is being saved."},savedStatus:{id:"rovo-personal