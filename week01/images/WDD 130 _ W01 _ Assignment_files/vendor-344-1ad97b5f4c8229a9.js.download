e ICU MessageFormat select statement resolves to an empty string when selectedIssueCount is 0 (no issues selected), or to "({selectedIssueCount} selected)" when selectedIssueCount is greater than 0. The selectedIssueCount placeholder will be substituted with the number of selected issues (e.g., "(3 selected)"). The purpose is to provide users with a clear indication of how many issues they have currently selected in the selector.'},expandButtonLabelText:{id:"issue-selector.expand-button-label-text",defaultMessage:"Expand list",description:"Button label displayed on a button in the issue selector header that expands the collapsed issue list to show all available issues in the AI conversation action interface. Shown as the text on a button. When clicked, it expands the issue list to reveal all selectable issues. The purpose is to allow users to view the full list of issues when it has been collapsed to save screen space."},collapseButtonLabelText:{id:"issue-selector.collapse-button-label-text",defaultMessage:"Collapse list",description:"Button label displayed on a button in the issue selector header that collapses the expanded issue list to hide it in the AI conversation action interface. Shown as the text on a button. When clicked, it collapses the issue list to show only the header with selected count. The purpose is to allow users to minimize the issue list to save screen space and reduce visual clutter."},selectAllCheckboxLabel:{id:"issue-selector.select-all-checkbox-label",defaultMessage:"Select all",description:"Accessibility label (aria-label) and visible label for a checkbox in the issue selector header that allows users to select or deselect all issues at once in the AI conversation action interface. Shown as the label text next to a checkbox. When checked, it selects all available issues in the list; when unchecked, it deselects all issues. The purpose is to provide users with a quick way to select or deselect all issues without having to click each one individually, and to make this functionality accessible to users with assistive technologies."}}),g="_18u01b66",y=function(e){var t=e.title,n=e.issueState,a=n.selectedIssueKeys,o=n.areAllIssuesSelected,l=n.totalIssueCount,u=e.isExpanded,y=e.isDisabled,k=e.handleExpandCollapse,_=e.handleSelectAllCheckboxChange,E=(0,p.A)().formatMessage;return r.createElement(s.c,{alignBlock:"center"},r.createElement(i.S,{"aria-label":E(b.selectAllCheckboxLabel),testId:"issue-selector-select-all-checkbox",isChecked:a.length>0,isDisabled:y,isIndeterminate:!o&&a.length>0,onChange:_}),r.createElement(m.A,{appearance:"subtle",spacing:"compact",icon:function(e){return u?r.createElement(h.A,(0,d.A)({},e,{size:"small"})):r.createElement(f.A,(0,d.A)({},e,{size:"small"}))},label:E(u?b.collapseButtonLabelText:b.expandButtonLabelText),onClick:k}),r.createElement(c.a,{xcss:g},r.createElement(v.E,{weight:"semibold"},t,r.createElement(c.a,{as:"span",xcss:"_18u01b66 _k48pi7a9 _syazazsu"},E(b.selectedIssuesLabel,{issueCount:l,selectedIssueCount:a.length})))))},k=function(e){var t=e.title,n=e.issueState,a=n.selectedIssueKeys,o=n.areAllIssuesSelected,l=(n.totalIssueCount,e.isDisabled),u=e.handleSelectAllCheckboxChange,d=(0,p.A)().formatMessage;return r.createElement(s.c,{alignBlock:"center"},r.createElement(i.S,{"aria-label":d(b.selectAllCheckboxLabel),testId:"issue-selector-select-all-checkbox",isChecked:a.length>0,isDisabled:l,isIndeterminate:!o&&a.length>0,onChange:u}),r.createElement(c.a,{xcss:g},r.createElement(v.E,{weight:"semibold"},t)))},_=n(98812);function E(e,t){var n=Object.keys(e);if(Object.getOwnPropertySymbols){var a=Object.getOwnPropertySymbols(e);t&&(a=a.filter(function(t){return Object.getOwnPropertyDescriptor(e,t).enumerable})),n.push.apply(n,a)}return n}function w(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{};t%2?E(Object(n),!0).forEach(function(t){(0,_.A)(e,t,n[t])}):Object.getOwnPropertyDescriptors?Object.defineProperties(e,Object.getOwnPropertyDescrip