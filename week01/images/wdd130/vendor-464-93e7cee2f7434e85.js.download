 for a checkbox that when checked will restrict who can access the new content once it is created"},contentTypePage:{id:"smart-creation.preview.add-to-space-popup.content-type-page",defaultMessage:"Page",description:"Button to select page as the content type."},contentTypeLiveDoc:{id:"smart-creation.preview.add-to-space-popup.content-type-live-doc",defaultMessage:"Live Doc",description:"Button to select live doc as the content type."},contentTypeButtonsLabel:{id:"smart-creation.preview.add-to-space-popup.content-type-buttons-label",defaultMessage:"Select type",description:"Label for two buttons that allow users to select the content type, either a live doc or a page."},applyToItems:{id:"smart-creation.preview.add-to-space-popup.apply-to-items",defaultMessage:"Add {count, plural, one {# artifact} other {# artifacts}} from this set",description:"Label for the select-all checkbox that applies the chosen space and parent to the selected created objects. {count} is the number of selected items."},toggleItemsLabel:{id:"smart-creation.preview.add-to-space-popup.toggle-items-label",defaultMessage:"Show or hide items",description:"Accessible label for the button that expands and collapses the list of items."},errorTitle:{id:"smart-creation.preview.add-to-space-popup.error-flag.title",defaultMessage:"We couldn’t add this to a space",description:"The title of the error flag when adding an object to a Confluence space fails."},errorDescription:{id:"smart-creation.preview.add-to-space-popup.error-flag.description",defaultMessage:"Reopen your Rovo chat and try again.",description:"The description of the error flag when adding an object to a Confluence space fails."},errorDescriptionApprovalRequired:{id:"rovo-platform-ui-components.shared.error.approval-required-for-first-publish",defaultMessage:"This space requires approval before publishing new pages. Please submit the page for review.",description:"User-facing message shown when the user tries to publish a page (e.g. via Rovo C