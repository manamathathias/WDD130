query TeamSearch($orgAri: ID!, $siteId: String!, $userId: ID!) {
  team {
    teamSearchV2(
      organizationId: $orgAri
      siteId: $siteId
      filter: {membership: {memberIds: [$userId]}}
    ) @optIn(to: "Team-search-v2") {
      nodes {
        team {
          displayName
          id
          smallAvatarImageUrl
        }
        memberCount
      }
    }
  }
}
