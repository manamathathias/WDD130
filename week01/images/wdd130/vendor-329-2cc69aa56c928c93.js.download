onversation.fail-to-validate-files-title",defaultMessage:"Failed to validate files",description:"Title text displayed at the top of an error dialog or notification when file validation fails during the upload process in the AI conversation. Shown as a dialog title to summarize the validation failure. The purpose is to immediately communicate that the validation process encountered an error."},failToValidateFilesDescription:{id:"ai-mate.upload-files-to-conversation.fail-to-validate-files-description",defaultMessage:"Error occurred while validating files, please try again.",description:"Description text displayed in an error dialog or notification body when file validation fails during upload to the AI conversation. Shown as error message text below the title to explain that a validation error occurred and prompts the user to retry. The purpose is to provide context about the failure and guide the user to attempt the upload again."},invalidFilesTitle:{id:"ai-mate.upload-files-to-conversation.refresh.invalid-files-title",defaultMessage:"{count, plural, one {File type} other {File types}} not supported",description:'Title text displayed at the top of an error dialog or notification when one or more uploaded files have unsupported file types. Shown as a dialog title. The ICU MessageFormat plural statement resolves to "File type" when count is 1, or "File types" when count is 2 or more. The count placeholder will be substituted with the number of invalid files. The purpose is to indicate how many files have unsupported types.'},invalidFilesDescription:{id:"ai-mate.upload-files-to-conversation.refresh.invalid-files-description",defaultMessage:'{count, plural, one {The file "{fileNames}" is not supported. Reason: {reasons}} other {The following files: "{fileNames}" are not supported. Reason: {reasons}}}',description:'Description text displayed in an error dialog or notification body explaining why specific files are invalid. Shown as error message text below the title. The ICU MessageFormat plural statement resolves to a singular message when count is 1, or a plural message when count is 2 or more. The count placeholder will be substituted with the number of invalid files. The fileNames placeholder will be substituted with a comma-separated list of file names (e.g., "document.pdf, image.jpg"). The reasons placeholder will be substituted with the validation failure reasons (e.g., "File type not supported, File too large"). The purpose is to provide detailed information about which files failed validation and why.'},fileInvalidIconLabel:{id:"ai-mate.upload-files-to-conversation.file-invalid-icon-label",defaultMessage:"File is invalid",description:"Accessibility label (aria-label) for an icon displayed next to invalid files in the file upload interface within the AI conversation. Shown as a screen reader announcement when the icon is focused or hovered. The purpose is to provide accessible information about the file validation status for users with assistive technologies."},validationErrorInvalidContentType:{id:"ai-mate.upload-files-to-conversation.validation-error-invalid-content-type",defaultMessage:"File type is not supported",description:"Error message displayed in a notification or validation error list when a user attempts to upload a file with an unsupported MIME type or file extension to the AI conversation. Shown as an error message to inform the user that the file format is not accepted. The purpose is to clearly communicate that the file type is the reason for the validation failure."},validationErrorFileTooLarge:{id:"ai-mate.upload-files-to-conversation.validation-error-file-too-large",defaultMessage:"File size is too large",description:"Error message displayed in a notification or validation error list when a user attempts to upload a file that exceeds the maximum allowed file size limit to the AI conversation. Shown as an error message to inform the user that the file is too large. The purpose is to clearly communicate that file size is the reason for the validation failure."},validationErrorFileNameMissing:{id:"ai-mate.upload-files-to-conversation.validation-error-file-name-missing",defaultMessage:"File name is missing",description:"Error message displayed in a notification or validation error list when a user attempts to upload a file without a name to the AI conversation. Shown as an error message to inform the user that the file must have a name. The purpose is to clearly communicate that a missing file name is the reason for the validation failure."},validationErrorUnknownError:{id:"ai-mate.upload-files-to-conversation.validation-error-unknown-error",defaultMessage:"Fail to validate file for unknown reason",description:"Error message displayed in a notification or validation error list when file validation fails for an unknown or unclassified reason during upload to the AI conversation. Shown as an error message to inform the user that validation failed but the specific cause could not be determined. The purpose is to provide a fallback error message when the system cannot identify the specific validation failure reason."},validationErrorMissingErrorCode:{id:"ai-mate.upload-files-to-conversation.validation-error-missing-error-code",defaultMessage:"Validation result unknown",description:"Error message displayed in a notification or validation error list when the validation service returns a response without a proper error code during file upload to the AI conversation. Shown as an error message to inform the user that the validation status could not be determined. The purpose is to communicate that the validation system returned an incomplete or malformed response."},validationErrorNotFound:{id:"ai-mate.upload-files-to-conversation.validation-error-not-found",defaultMessage:"Validation result is not found",description:"Error message displayed in a notification or validation error list when the system cannot retrieve the validation result for an uploaded file in the AI conversation, typically due to the validation request being lost or the result expiring. Shown as an error message to inform the user that the validation status could not be retrieved. The purpose is to communicate that the validation result is missing or unavailable."}}),A=function(e){switch(e){case"INVALID_CONTENT_TYPE":return b.validationErrorInvalidContentType;case"FILE_TOO_LARGE":return b.validationErrorFileTooLarge;case"FILE_NAME_MISSING":return b.validationErrorFileNameMissing;case"VALIDATION_RESULT_MISSING_ERROR_CODE":return b.validationErrorMissingErrorCode;case"VALIDATION_RESULT_NOT_FOUND":return b.validationErrorNotFound;default:return b.validationErrorUnknownError}},w=function(e,t){return l.createElement(d.a,{testId:"file-upload-input",as:"input",ref:e,hidden:!0,type:"file",multiple:!0,onChange:t})},S=(0,m.HZ)(function(e){var t,n=e.key,a=e.stableFileInputChange,d=e.assistanceServiceInjectedParams,m=d.assistanceService,S=d.experienceTracker,E=(0,g.L)(n),O=(0,i.A)(E,2),I=O[0],T=O[1],F=T.addFiles,C=T.removeFile,_=T.clearFiles,L=T.updateFileWithName,k=T.clearAttachments,N=(0,s.A)().formatMessage,M=(0,p.s)().sendAnalyticsEvent,j=(0,l.useMemo)(function(){return I.some(function(e){return e.isLoading})},[I]),P=(0,u.D)().showFlag,U=(0,h.n)({mutationFn:function(e){return S.start({id:f.US.UPLOAD_FILES_TO_CONVERSATION,name:f.US.UPLOAD_FILES_TO_CONVERSATION}),F(n,[{id:"",name:e.file.name,isLoading:!0,fileObject:e.file}],M),m.uploadFiles({files:[e.file]})},onSuccess:function(e){e.data.forEach(function(e){L(n,e.name,{id:e.id,isLoading:!1}),M({action:"added",actionSubject:"rovoChatContext",actionSubjectId:"file",attributes:{fileType:e.type||"unknown",fileSize:e.size||0}})}),S.succeed({name:f.US.UPLOAD_FILES_TO_CONVERSATION})},onError:function(e,t){var r=e.errorAttributes.statusCode===v.I_.UNSUPPORTED_FILE_TYPE?N(b.unsupportedFile):e.errorAttributes.errorCode===v.n9.FILE_SIZE_TOO_LARGE?e.errorAttributes.rawErrorMessage:e.errorAttributes.statusCode===v.I_.FILE_RAI_POLICY_VIOLATION?N(