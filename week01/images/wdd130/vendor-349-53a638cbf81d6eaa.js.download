Message:"Summary",description:"Label text displayed above or next to a summary input field in the Jira Service Management (JSM) request creation form within the AI conversation interface. Shown as a form field label. The purpose is to identify the summary input field, which allows users to enter or edit a brief summary of the service request."},descriptionLabel:{id:"conversation-assistant-message-actions.jsm-create-request.description-label",defaultMessage:"Description",description:"Label text displayed above or next to a description input field in the Jira Service Management (JSM) request creation form within the AI conversation interface. Shown as a form field label. The purpose is to identify the description input field, which allows users to enter or edit detailed information about the service request."},createRequestButton:{id:"conversation-assistant-message-actions.jsm-create-request.create-request-button-1",defaultMessage:"Raise request",description:"Button label displayed on the primary action button in the Jira Service Management (JSM) request creation action card within the AI conversation interface. Shown as the text on a button at the bottom of the action card. When clicked, it creates and submits the service request to JSM. The purpose is to provide a clear call-to-action for users to confirm and execute creating the service request."},jsmRequestCreatedTitle:{id:"conversation-assistant-message-actions.jsm-create-request.created-title-1",defaultMessage:"Request raised",description:"Title text displayed at the top of a success notification or dialog after a Jira Service Management (JSM) service request has been successfully created within the AI conversation interface. Shown as the notification or dialog header title. The purpose is to immediately communicate to the user that the request creation was successful."},jsmRequestCreatedDescription:{id:"conversation-assistant-message-actions.jsm-create-request.created-description-1",defaultMessage:"Your service request has been raised successfully.",description:"Success message text displayed in the body of a success notification or dialog after a Jira Service Management (JSM) service request has been successfully created within the AI conversation interface. Shown as the description text below the success title. The purpose is to confirm the successful creation of the service request and inform the user that their request is now active."},jsmRequestErrorTitle:{id:"conversation-assistant-message-actions.jsm-create-request.error-title-1",defaultMessage:"Error raising request",description:"Title text displayed at the top of an error notification or dialog when a Jira Service Management (JSM) service request creation fails within the AI conversation interface. Shown as the error notification or dialog header title. The purpose is to immediately communicate to the user that an error occurred during request creation."},jsmRequestErrorDescription:{id:"conversation-assistant-message-actions.jsm-create-request.error-description-1",defaultMessage:"There was an error raising your service request. Please try again.",description:"Error message text displayed in the body of an error notification or dialog when a Jira Service Management (JSM) service request creation fails within the AI conversation interface. Shown as the error description text below the error title. The purpose is to inform the user that the request creation encountered an error and prompt them to retry the action."},additionalFieldsLabel:{id:"conversation-assistant-message-actions.jsm-create-request.additional-fields-label",defaultMessage:"Additional Fields:",description:"Label text displayed above a section containing additional custom fields in the Jira Service Management (JSM) request creation form within the AI conversation interface. Shown as a section label or heading. The purpose is to identify the section that contains extra fields beyond the standard summary and description fields, such as custom fields specific to the request type or service project."},fieldNotSet:{id:"conversation-assistant-message-actions.jsm-create-request.field-not-set",defaultMessage:"Not set",description:"Placeholder text displayed when an additional field in the Jira Service Management (JSM) request creation form has no value. Shown as the field value text. The purpose is to indicate to the user that the field currently has no value assigned."}});function C(e,t){var n=Object.keys(e);if(Object.getOwnPropertySymbols){var a=Object.getOwnPropertySymbols(e);t&&(a=a.filter(function(t){return Object.getOwnPropertyDescriptor(e,t).enumerable})),n.push.apply(n,a)}return n}function M(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{};t%2?C(Object(n),!0).forEach(function(t){(0,o.A)(e,t,n[t])}):Object.getOwnPropertyDescriptors?Object.defineProperties(e,Object.getOwnPropertyDescriptors(n)):C(Object(n)).forEach(function(t){Object.defineProperty(e,t,Object.getOwnPropertyDescriptor(n,t))})}return e}var z=function(e){e.onCustomDataActioned;var t,n,s,r,o,u,m=e.actions,b=e.getStatus,x=e.getReadonly,q=e.cloudId,w=e.ContentRenderer,j=e.productKey,C=e.sendMessageConfirmedTools,z=e.recipientAgentId,D=e.conversationId,T=e.messageId,R=(0,d.A)().formatMessage,B=(0,E.s)().sendAnalyticsEvent,P=(0,f.D)().showFlag,J=m[0],L=b(J),N=x(J),F="idle"!==L||N,K=(0,A.wO)(J)?J.data.inputs:J.data,V=function(){var e;return(null==(e=K.requestFieldValues)?void 0:e.summary)||K.summary},G=function(){var e;return(null==(e=K.requestFieldValues)?void 0:e.description)||K.description},H=null!=(t=K.form)&&t.answers?(0,A.GX)(K.form.answers):{},Y=M(M({},K.requestFieldValues),H),Q=Object.keys(Y).length>0?(0,A.Ke)(Y,(null==(n=J.metadata)?void 0:n.requestFieldNames)||K.requestFieldNames,null==(s=J.metadata)?void 0:s.formFieldNames,null==(r=J.metadata)?void 0:r.formFieldChoices,(0,_.fg)("support_asset_field_for_raise_request")&&null!=(o=null==(u=J.metadata)?void 0:u.assetNames)?o:{}):[],U=(0,a.useState)(M(M({},V()&&{summary