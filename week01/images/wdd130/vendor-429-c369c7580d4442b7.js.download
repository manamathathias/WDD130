ser.name"],providerId:["provider.providerId"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/graph/document.svg",thirdPartyIconPath:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/third-party-logos/{replaceProductName}/default.svg"}},MercuryFocusArea:{hydratorPaths:{id:["id"],name:["name"],url:["url"],key:["focusAreaType.name"],icon:["icon.url"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/mercury/focus-area.svg"}},MercuryPortfolio:{hydratorPaths:{id:["id"],name:["name"],url:["url"],key:["label"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/mercury/view.svg"}},RadarPosition:{hydratorPaths:{id:["id"],name:["worker.preferredName"],url:["url"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/talent/position.svg"}},RadarView:{hydratorPaths:{id:["id"],name:["viewName"],url:["url"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/talent/view.svg"}},CompassComponent:{hydratorPaths:{id:["id"],name:["name"],url:["url"],icon:["typeMetadata.iconUrl"],key:["typeMetadata.name"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/compass/logo.svg"}},BitbucketPullRequest:{hydratorPaths:{id:["id"],name:["pullRequestTitle"],url:["href"],key:["pullRequestTitle"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/bitbucket/logo.svg"}},LoomVideo:{hydratorPaths:{id:["id"],name:["name"],url:["loomUrl"],key:["owner.name"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/loom/logo.svg"}},AssetsObject:{hydratorPaths:{id:["id"],name:["label"],key:["displayTypename"],url:["links.web"],icon:["avatar.url48"],containers:["objectType.schema.name"],containersWithDisplayName:["objectType.schema.displayName"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/assets/logo.svg"}},AssetsObjectType:{hydratorPaths:{id:["id"],name:["assetsObjectTypeName"],displayName:["assetsObjectTypeDisplayName"],key:["displayTypename"],url:["links.web"],icon:["assetsObjectTypeIcon.url48"],containers:["schema.assetsSchemaName"],containersWithDisplayName:["schema.assetsSchemaDisplayName"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/assets/logo.svg"}},AssetsSchema:{hydratorPaths:{id:["id"],name:["assetsSchemaName"],displayName:["assetsSchemaDisplayName"],key:["displayTypename"],url:["links.web"]},staticFallbacks:{icon:"https://flight-deck-assets-bifrost.prod-east.frontend.public.atl-paas.net/assets/image/misc-icons/assets/logo.svg"}}},queryFragments:`

  fragment townsquareGoal on TownsquareGoal {
    id
    key
    name
    url
    iconData
    status {
      value
      score
    }
  }


  fragment townsquareProject on TownsquareProject {
    id
    key
    name
    url
    iconData
    state {
      value
    }
  }


  fragment townsquareComment on TownsquareComment {
    id
    url
    container {
      __typename
      ...townsquareGoal
      ...townsquareProject
    }
  }


  fragment confluencePage on ConfluencePage {
    id
    title
    pageId
    subtype
    links {
      base
      webUi
    }
    space {
      name
    }
  }


  fragment confluenceBlogPost on ConfluenceBlogPost {
    id
    title
    blogPostId
    links {
      base
      webUi
    }
    space {
      name
    }
  }


  fragment confluenceWhiteboard on ConfluenceWhiteboard {
    id
    title
    whiteboardId
    links {
      base
      webUi
    }
    space {
      name
    }
  }


  fragment confluenceDatabase on ConfluenceDatabase {
    id
    title
    databaseId
    links {
      base
      webUi
    }
    space {
      name
    }
  }


  fragment confluenceEmbed on ConfluenceEmbed {
    id
    title
    embedId
    links {
      base
      webUi
    }
    space {
      name
    }
  }


  fragment confluenceComment on ConfluenceComment {
    id
    links {
      base
      webUi
    }
    container {
      __typename
      ...confluenceBlogPost
      ...confluencePage
      ...confluenceWhiteboard
    }
  }


  fragment confluenceFooterComment on ConfluenceFooterComment {
    id
    links {
      base
      webUi
    }
    container {
      __typename
      ...confluenceBlogPost
      ...confluencePage
      ...confluenceWhiteboard
    }
  }


  fragment confluenceInlineComment on ConfluenceInlineComment {
    id
    links {
      base
      webUi
    }
    container {
      __typename
      ...confluenceBlogPost
      ...confluencePage
      ...confluenceWhiteboard
    }
  }


fragment jiraIssue on JiraIssue {
  id
  key
  webUrl
  fieldsById(ids: ["summary", "issuetype", "project"]) {
    edges {
      node {
        __typename
        fieldId
        ...jiraSingleLineTextField
        ...jiraIssueTypeField
        ...jiraProjectField
      }
    }
  }
  fieldsByIdOrAlias(idsOrAliases: ["status"]) @optIn(to: "JiraIssueFieldsByIdOrAlias") {
    __typename
    fieldId
    ...jiraStatusField
  }
}
fragment jiraSingleLineTextField on JiraSingleLineTextField {
  text
}
fragment jiraIssueTypeField on JiraIssueTypeField {
  issueType {
    name
    avatar {
      medium
    }
  }
}
fragment jiraProjectField on JiraProjectField {
  project {
    name
  }
}
fragment jiraStatusField on JiraStatusField {
  status {
    name
    statusCategory {
      colorName
    }
  }
}


fragment jiraPlatformComment on JiraPlatformComment {
  commentId
  webUrl
  issue {
    ...jiraIssue
  }
}


fragment jiraServiceManagementComment on JiraServiceManagementComment {
  commentId
  webUrl
  issue {
    ...jiraIssue
  }
}


fragment trelloBoard on TrelloBoard {
  id
  objectId
  boardName: name
  boardUrl: url
  workspace {
    id
    displayName
  }
}


fragment trelloCard on TrelloCard {
  id
  objectId
  cardName: name
  cardUrl: url
  list {
    id
    name
    board @optIn(to: "TrelloListBoard") {
      id
      name
    }
  }
}


        fragment graphDevOpsDocument on DevOpsDocument {
          id
          displayName
          webUrl: url
          type {
            iconUrl
          }
        }
    

        fragment graphExternalDocument on ExternalDocument {
            id
            type {
                category
            }
            displayName
            parent @optIn(to: "ExternalDataDepotQueryV2"){
                ...on ExternalDocument {
                    displayName
                }
            }
            url
            provider {
                providerId
            }
            createdBy {
                thirdPartyUser {
                    name
                }
            }
            thirdPartyId
        }
    

fragment graphPullRequest on DevOpsPullRequestDetails {
  id
  title
  url
  repositoryName
  providerName
}


fragment graphExternalPullRequest on ExternalPullRequest {
  id
  displayName
  url
  pullRequestStatus: status
  provider {
    providerId
  }
}


fragment graphExternalWorkItem on ExternalWorkItem {
  id
  displayName
  url
  workItemStatus: status
  provider {
    providerId
  }
}


fragment graphDesign on DevOpsDesign {
  id
  displayName
  webUrl: url
}


        fragment graphExternalRemoteLink on ExternalRemoteLink {
            id
            displayName
            category
            createdBy {
                thirdPartyUser {
                    name
                }
            }
            url
            provider {
                providerId
            }
            thirdPartyId
        }
    

    fragment mercuryFocusArea on MercuryFocusArea {
        id
        name
        url
        focusAreaType {
            name
        }
        icon {
            url
        }
    }
    

    fragment mercuryPortfolio on MercuryPortfolio {
        id
        name
        url
        label
    }
    

    fragment radarPosition on RadarPosition {
        id
        worker {
            preferredName
        }
        url
    }
    

    fragment radarView on RadarView {
        id
        viewName
        url
    }
    

fragment compassComponent on CompassComponent {
  id
  name
  url
  typeMetadata {
    iconUrl
    name
  }
}


fragment bitbucketPullRequest on BitbucketPullRequest {
  id
  pullRequestTitle: title
  href
  author {
    picture
  }
}


fragment loomVideo on LoomVideo {
  id
  name
  loomUrl: url
  owner {
    name
    picture
  }
}


    fragment assetsObject on AssetsObject {
      id
      label
      objectKey
      links {
        web
      }
      avatar {
        url48
      }
      objectType {
        name
        displayName
        schema {
          name
          displayName
        }
      }
      displayTypename @optIn(to: "AssetsApFields")
    }


    fragment assetsObjectType on AssetsObjectType {
      id
      assetsObjectTypeName: name
      assetsObjectTypeDisplayName: displayName
      links {
        web
      }
      assetsObjectTypeIcon: icon {
        url48
      }
      schema {
        id
        assetsSchemaName: name
        assetsSchemaDisplayName: displayName
      }
      displayTypename @optIn(to: "AssetsApFields")
    }


    fragment assetsSchema on AssetsSchema {
      id
      assetsSchemaKey: key
      assetsSchemaName: name
      assetsSchemaDisplayName: displayName
      links {
        web
      }
      displayTypename @optIn(to: "AssetsApFields")
    }

fragment activityItemEdge on ActivityItemEdge {
  cursor
  node {
    id
    object {
      id
      type
      product
      subProduct
      rootContainerId
      contributors {
        profile {
          name
          picture
          accountId
        }
      }
      data {
        __typename
	...townsquareGoal
	...townsquareProject
	...townsquareComment
	...confluencePage
	...confluenceBlogPost
	...confluenceWhiteboard
	...confluenceDatabase
	...confluenceEmbed
	...confluenceComment
	...confluenceFooterComment
	...confluenceInlineComment
	...jiraIssue
	...jiraPlatformComment
	...jiraServiceManagementComment
	...trelloBoard
	...trelloCard
	...graphDevOpsDocument
	...graphExternalDocument
	...graphPullRequest
	...graphExternalPullRequest
	...graphExternalWorkItem
	...graphDesign
	...graphExternalRemoteLink
	...mercuryFocusArea
	...mercuryPortfolio
	...radarPosition
	...radarView
	...compassComponent
	...bitbucketPullRequest
	...loomVideo
	...assetsObject
	...assetsObjectType
	...assetsSchema
      }
    }
    event {
      id
      timestamp
      eventType
      actor {
        name
        picture
        accountId
      }
    }
  }
}
fragment activityItemConnection on ActivityConnection {
  edges {
    ...activityItemEdge
  }
}

